# Raw course data stays local. Preserve directory placeholders only.
data/raw/**
!data/raw/**/
!data/raw/**/.gitkeep
data/processed/**
!data/processed/.gitkeep
data/derived/**
!data/derived/.gitkeep
.env
.env.*
!.env.example
*credential*
*token*.json
kaggle.json
.venv/
venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/
artifacts/
# Small, label-free team handoff exports; raw data and run bundles stay ignored.
!handoff/classification_team_20261108/artifacts/
handoff/classification_team_20261108/artifacts/*
!handoff/classification_team_20261108/artifacts/MANIFEST.json
!handoff/classification_team_20261108/artifacts/validation_probabilities.csv.gz
!handoff/classification_team_20261108/artifacts/test_probabilities.csv.gz
/models/
*.pkl
*.pickle
*.joblib
*.onnx
*.pt
*.pth
*.zip
submissions/**
!submissions/.gitkeep
experiments/runs/**
!experiments/runs/.gitkeep
.DS_Store
Thumbs.db
